 "frases": [
  {
   "texto": "Este hombre tiró a la basura unos 600 millones de dólares.",
   "inicio": 0.0,
   "fin": 3.65
  },
  {
   "texto": "Gales, 2009.",
   "inicio": 3.65,
   "fin": 5.3
  },
  {
   "texto": "James Howells es ingeniero informático y empieza a minar bitcoins en su ordenador, cuando casi nadie sabía qué eran.",
   "inicio": 5.3,
   "fin": 12.33
  },
  {
   "texto": "Junta 8.000.",
   "inicio": 12.33,
   "fin": 13.64
  },
  {
   "texto": "En ese momento valen prácticamente nada.",
   "inicio": 13.64,
   "fin": 16.25
  },
  {
   "texto": "En 2013, ordenando su casa, tira un disco duro viejo a la basura.",
   "inicio": 16.25,
   "fin": 20.72
  },
  {
   "texto": "En ese disco estaban las claves de sus 8.000 bitcoins.",
   "inicio": 20.73,
   "fin": 24.32
  },
  {
   "texto": "El disco termina enterrado en un vertedero, bajo miles de toneladas de basura.",
   "inicio": 24.32,
   "fin": 28.88
  },
  {
   "texto": "Cuando Howells se da cuenta, ya es tarde.",
   "inicio": 28.89,
   "fin": 31.6
  },
  {
   "texto": "Le pide al ayuntamiento permiso para excavar.",
   "inicio": 31.6,
   "fin": 34.42
  },
  {
   "texto": "Ofrece pagar la búsqueda y compartir el dinero con la ciudad.",
   "inicio": 34.42,
   "fin": 38.18
  },
  {
   "texto": "La respuesta es siempre no: por riesgos ambientales.",
   "inicio": 38.18,
   "fin": 41.69
  },
  {
   "texto": "Llevó el caso a los tribunales, y en 2025 un juez rechazó su demanda.",
   "inicio": 41.69,
   "fin": 46.63
  },
  {
   "texto": "Sus bitcoins siguen ahí abajo.",
   "inicio": 46.64,
   "fin": 48.75
  },
  {
   "texto": "¿Tú seguirías buscando?",
   "inicio": 48.75,
   "fin": 50.88
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 50.88,
   "fin": 53.0
  }
 ],
 "duracion": 53.0
}