 "frases": [
  {
   "texto": "Blockbuster pudo comprar Netflix por 50 millones de dólares.",
   "inicio": 0.0,
   "fin": 3.77
  },
  {
   "texto": "Y se rio.",
   "inicio": 3.77,
   "fin": 4.87
  },
  {
   "texto": "Año 2000.",
   "inicio": 4.87,
   "fin": 6.37
  },
  {
   "texto": "Blockbuster es el rey del alquiler de películas: más de 9.000 tiendas en el mundo.",
   "inicio": 6.37,
   "fin": 11.99
  },
  {
   "texto": "Netflix es una pequeña empresa que envía DVD por correo y pierde dinero.",
   "inicio": 11.99,
   "fin": 16.57
  },
  {
   "texto": "Sus fundadores, Reed Hastings y Marc Randolph, viajan a Dallas a reunirse con el jefe de Blockbuster.",
   "inicio": 16.57,
   "fin": 22.64
  },
  {
   "texto": "Le proponen algo: compren Netflix por 50 millones y nosotros manejamos su negocio en internet.",
   "inicio": 22.64,
   "fin": 29.36
  },
  {
   "texto": "Según ellos, el jefe de Blockbuster casi no pudo aguantar la risa.",
   "inicio": 29.36,
   "fin": 33.53
  },
  {
   "texto": "La respuesta fue no.",
   "inicio": 33.53,
   "fin": 34.84
  },
  {
   "texto": "Diez años después, en 2010, Blockbuster quebró.",
   "inicio": 34.84,
   "fin": 38.38
  },
  {
   "texto": "Hoy queda una sola tienda en el mundo, en Oregón.",
   "inicio": 38.38,
   "fin": 41.96
  },
  {
   "texto": "Y Netflix vale cientos de miles de millones de dólares.",
   "inicio": 41.96,
   "fin": 45.55
  },
  {
   "texto": "¿Tú habrías comprado Netflix?",
   "inicio": 45.55,
   "fin": 47.64
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 47.64,
   "fin": 50.21
  }
 ],
 "duracion": 50.21
}