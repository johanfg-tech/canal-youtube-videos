 "frases": [
  {
   "texto": "Un error de un dedo costó 340 millones de dólares.",
   "inicio": 0.0,
   "fin": 3.85
  },
  {
   "texto": "Tokio, 8 de diciembre de 2005.",
   "inicio": 3.85,
   "fin": 7.24
  },
  {
   "texto": "Una empresa sale a bolsa ese día.",
   "inicio": 7.24,
   "fin": 10.05
  },
  {
   "texto": "Un operador del banco Mizuho quiere vender una acción a 610.000 yenes.",
   "inicio": 10.05,
   "fin": 15.12
  },
  {
   "texto": "Pero se equivoca de casilla.",
   "inicio": 15.12,
   "fin": 17.19
  },
  {
   "texto": "Y vende 610.000 acciones a 1 yen cada una.",
   "inicio": 17.19,
   "fin": 20.84
  },
  {
   "texto": "Es una locura: la empresa ni siquiera tenía tantas acciones.",
   "inicio": 20.85,
   "fin": 24.27
  },
  {
   "texto": "Tenía 41 veces menos.",
   "inicio": 24.27,
   "fin": 26.28
  },
  {
   "texto": "El sistema muestra una alerta, pero el operador la ignora.",
   "inicio": 26.28,
   "fin": 30.51
  },
  {
   "texto": "Intentan cancelar la orden, y el sistema de la bolsa falla.",
   "inicio": 30.51,
   "fin": 34.53
  },
  {
   "texto": "En minutos, el precio se derrumba y miles de inversores compran a precio de ganga.",
   "inicio": 34.53,
   "fin": 39.55
  },
  {
   "texto": "Mizuho perdió unos 340 millones de dólares.",
   "inicio": 39.55,
   "fin": 42.94
  },
  {
   "texto": "Un joven inversor de 27 años ganó unos 17 millones en un rato.",
   "inicio": 42.94,
   "fin": 47.75
  },
  {
   "texto": "Meses después, el jefe de la bolsa de Tokio renunció.",
   "inicio": 47.75,
   "fin": 51.22
  },
  {
   "texto": "¿Tú revisas dos veces antes de pagar?",
   "inicio": 51.22,
   "fin": 53.83
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 53.83,
   "fin": 56.45
  }
 ],
 "duracion": 56.45
}