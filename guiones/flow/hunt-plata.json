 "frases": [
  {
   "texto": "Dos hermanos intentaron quedarse con toda la plata del mundo.",
   "inicio": 0.0,
   "fin": 3.39
  },
  {
   "texto": "Texas, 1979.",
   "inicio": 3.39,
   "fin": 6.04
  },
  {
   "texto": "Nelson y Herbert Hunt son hijos de uno de los hombres más ricos de Estados Unidos.",
   "inicio": 6.04,
   "fin": 11.2
  },
  {
   "texto": "Temen que la inflación destruya el dólar, así que empiezan a comprar plata.",
   "inicio": 11.2,
   "fin": 16.45
  },
  {
   "texto": "Mucha plata.",
   "inicio": 16.45,
   "fin": 17.74
  },
  {
   "texto": "Compran con dinero prestado, y llegan a controlar una enorme parte de la plata disponible del mundo.",
   "inicio": 17.74,
   "fin": 23.89
  },
  {
   "texto": "El precio se dispara: de unos 6 dólares la onza a casi 50 en solo un año.",
   "inicio": 23.9,
   "fin": 28.83
  },
  {
   "texto": "La gente hace filas para vender los cubiertos de la abuela.",
   "inicio": 28.83,
   "fin": 33.03
  },
  {
   "texto": "Entonces la bolsa cambia las reglas y prohíbe comprar plata con tanto dinero prestado.",
   "inicio": 33.04,
   "fin": 38.21
  },
  {
   "texto": "El 27 de marzo de 1980, el precio se hunde.",
   "inicio": 38.21,
   "fin": 42.58
  },
  {
   "texto": "Ese día se conoce como el Jueves de Plata.",
   "inicio": 42.58,
   "fin": 45.05
  },
  {
   "texto": "Los Hunt no pueden pagar sus deudas.",
   "inicio": 45.05,
   "fin": 47.66
  },
  {
   "texto": "Perdieron miles de millones y terminaron en bancarrota.",
   "inicio": 47.66,
   "fin": 50.96
  },
  {
   "texto": "¿Tú habrías vendido tu plata?",
   "inicio": 50.96,
   "fin": 53.1
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 53.1,
   "fin": 55.72
  }
 ],
 "duracion": 55.72
}