 "frases": [
  {
   "texto": "Este rey regaló tanto oro que arruinó una ciudad.",
   "inicio": 0.0,
   "fin": 2.87
  },
  {
   "texto": "1324.",
   "inicio": 2.87,
   "fin": 5.06
  },
  {
   "texto": "Mansa Musa gobierna el Imperio de Mali, en África occidental, y es dueño de algunas de las minas de oro más grandes del mundo.",
   "inicio": 5.07,
   "fin": 12.85
  },
  {
   "texto": "Decide peregrinar a La Meca.",
   "inicio": 12.85,
   "fin": 14.96
  },
  {
   "texto": "Pero no viaja solo: lo acompañan miles de personas y una caravana de camellos cargados de oro.",
   "inicio": 14.96,
   "fin": 21.04
  },
  {
   "texto": "Al pasar por El Cairo, regala oro a todo el mundo: a los pobres, a los funcionarios, a los comerciantes.",
   "inicio": 21.04,
   "fin": 27.42
  },
  {
   "texto": "Hay tanto oro circulando que su valor se desploma.",
   "inicio": 27.42,
   "fin": 30.75
  },
  {
   "texto": "Según los cronistas, el precio del oro en El Cairo tardó unos doce años en recuperarse.",
   "inicio": 30.75,
   "fin": 36.01
  },
  {
   "texto": "Para arreglarlo, al volver, Mansa Musa pidió oro prestado a los prestamistas de la ciudad.",
   "inicio": 36.01,
   "fin": 41.65
  },
  {
   "texto": "Muchos historiadores dicen que fue la persona más rica de la historia.",
   "inicio": 41.65,
   "fin": 45.98
  },
  {
   "texto": "Su fortuna es imposible de calcular.",
   "inicio": 45.98,
   "fin": 48.46
  },
  {
   "texto": "¿Qué harías tú con tanto oro?",
   "inicio": 48.46,
   "fin": 50.67
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 50.68,
   "fin": 53.32
  }
 ],
 "duracion": 53.32
}