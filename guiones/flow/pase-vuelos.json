 "frases": [
  {
   "texto": "Pagó 250.000 dólares por volar gratis toda la vida.",
   "inicio": 0.0,
   "fin": 3.77
  },
  {
   "texto": "1981.",
   "inicio": 3.77,
   "fin": 6.61
  },
  {
   "texto": "American Airlines necesita dinero rápido y lanza el AAirpass: primera clase, sin límite, para siempre.",
   "inicio": 6.62,
   "fin": 12.26
  },
  {
   "texto": "En 1987, Steven Rothstein, un hombre de negocios de Chicago, lo compra por 250.000 dólares.",
   "inicio": 12.26,
   "fin": 19.8
  },
  {
   "texto": "Dos años después paga 150.000 más por un pase para un acompañante.",
   "inicio": 19.81,
   "fin": 24.54
  },
  {
   "texto": "Y empieza a volar.",
   "inicio": 24.54,
   "fin": 25.71
  },
  {
   "texto": "A Londres, solo para almorzar con un amigo.",
   "inicio": 25.71,
   "fin": 28.88
  },
  {
   "texto": "A París, y de vuelta el mismo día.",
   "inicio": 28.89,
   "fin": 31.25
  },
  {
   "texto": "Regala el asiento de acompañante a desconocidos que lo necesitan.",
   "inicio": 31.25,
   "fin": 35.14
  },
  {
   "texto": "En unos 20 años hace más de 10.000 vuelos.",
   "inicio": 35.14,
   "fin": 38.31
  },
  {
   "texto": "La aerolínea calcula que le cuesta un millón de dólares al año.",
   "inicio": 38.31,
   "fin": 42.14
  },
  {
   "texto": "En 2008, a punto de subir a un avión, le entregan una carta: su pase queda cancelado.",
   "inicio": 42.14,
   "fin": 48.0
  },
  {
   "texto": "Él demanda a la aerolínea, pero nunca recupera el pase.",
   "inicio": 48.0,
   "fin": 51.47
  },
  {
   "texto": "¿Tú lo habrías comprado?",
   "inicio": 51.47,
   "fin": 53.82
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 53.82,
   "fin": 55.95
  }
 ],
 "duracion": 55.95
}