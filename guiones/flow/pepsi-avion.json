 "frases": [
  {
   "texto": "Un estudiante intentó cobrarle a Pepsi un avión de combate.",
   "inicio": 0.0,
   "fin": 3.35
  },
  {
   "texto": "1996.",
   "inicio": 3.36,
   "fin": 5.73
  },
  {
   "texto": "Pepsi lanza una promoción: compras refrescos, juntas puntos y los cambias por premios.",
   "inicio": 5.73,
   "fin": 11.24
  },
  {
   "texto": "Una camiseta, 75 puntos.",
   "inicio": 11.24,
   "fin": 13.74
  },
  {
   "texto": "Unas gafas de sol, 175.",
   "inicio": 13.74,
   "fin": 16.17
  },
  {
   "texto": "Y al final del anuncio, de broma, un avión de combate Harrier: 7 millones de puntos.",
   "inicio": 16.17,
   "fin": 21.59
  },
  {
   "texto": "John Leonard, de 21 años, lee la letra pequeña.",
   "inicio": 21.59,
   "fin": 25.0
  },
  {
   "texto": "Los puntos también se podían comprar a 10 centavos cada uno.",
   "inicio": 25.0,
   "fin": 28.96
  },
  {
   "texto": "7 millones de puntos eran 700.000 dólares.",
   "inicio": 28.96,
   "fin": 32.33
  },
  {
   "texto": "Y el avión valía unos 33 millones.",
   "inicio": 32.33,
   "fin": 35.34
  },
  {
   "texto": "Leonard convence a cinco inversores, junta el dinero y le envía a Pepsi un cheque de 700.008 dólares.",
   "inicio": 35.34,
   "fin": 42.33
  },
  {
   "texto": "Pepsi dice que era un chiste.",
   "inicio": 42.33,
   "fin": 44.5
  },
  {
   "texto": "Leonard la demanda.",
   "inicio": 44.5,
   "fin": 46.04
  },
  {
   "texto": "En 1999, una jueza decide que ninguna persona razonable creería que regalaban un avión.",
   "inicio": 46.04,
   "fin": 52.69
  },
  {
   "texto": "Leonard pierde.",
   "inicio": 52.69,
   "fin": 54.04
  },
  {
   "texto": "Pero Pepsi cambió el anuncio: el avión pasó a costar 700 millones de puntos.",
   "inicio": 54.05,
   "fin": 59.38
  },
  {
   "texto": "¿Tú lo habrías intentado?",
   "inicio": 59.38,
   "fin": 61.63
  },
  {
   "texto": "Sígueme para más historias de dinero.",
   "inicio": 61.63,
   "fin": 63.79
  }
 ],
 "duracion": 63.79
}